main() {

    if [ aintFile ];then 
        touch $TEMP
    fi

   case $1 in
        # "-a")
        #     # take number and then alias
        #     makeAlias $2 $3
        # ;;
        -clr|--clear)
            > $TEMP
        ;;
        '')
            if alreadyWatched; then
        #        echo "Already watching directory"
		printf "${RED}Already watching directory${NC}\n"
            else
                pwd >> $TEMP    
            fi
        ;;
        -p|--print)
            printDirs
        ;;
        -l|--length)
            length
        ;;
        -cp|--copy)
            printf '"%s"' "$(findDir $2)" | pbcopy
        ;;
        -h|--help)
            help
        ;;
        *)
            echo "You need help. Use -h for help. thanks"
            exit 1
        ;;
    esac

    exit 0
}

main $@
